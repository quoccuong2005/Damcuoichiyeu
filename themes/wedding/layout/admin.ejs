<div class="admin-container">
    <div class="admin-card">
        <div class="admin-header">
            <h1><i class="fas fa-user-shield"></i> Quản Lý Khách Mời</h1>
            <p>Tạo và quản lý thiệp mời cá nhân hóa</p>
        </div>

        <!-- Login Form -->
        <form id="loginForm">
            <div class="form-group">
                <label for="adminPassword">Mật khẩu:</label>
                <input type="password" id="adminPassword" placeholder="Nhập mật khẩu admin" required
                    autocomplete="current-password">
            </div>
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-sign-in-alt"></i> Đăng nhập
            </button>
            <div class="error-message" id="errorMessage"></div>
            <div
                style="margin-top: 20px; padding: 15px; background: #fff3cd; border-radius: 8px; font-size: 14px; color: #856404;">

            </div>
        </form>

        <!-- Admin Panel (hidden by default) -->
        <div id="adminPanel" style="display: none;">
            <!-- Add Guest Form -->
            <form id="addGuestForm">
                <div class="form-group">
                    <label for="guestName">
                        <i class="fas fa-user-plus"></i> Tên Khách Mời:
                    </label>
                    <input type="text" id="guestName" placeholder="Ví dụ: Nguyễn Văn A" required autocomplete="off">
                </div>
                <div class="form-group">
                    <label for="guestSide">
                        <i class="fas fa-home"></i> Bên:
                    </label>
                    <select id="guestSide" required>
                        <option value="nha-trai">🤵 Nhà Trai</option>
                        <option value="nha-gai">👰 Nhà Gái</option>
                    </select>
                </div>
                <div class="form-group checkbox-group">
                    <label class="checkbox-label">
                        <input type="checkbox" id="showGiftBox" checked>
                        <i class="fas fa-gift"></i> Hiển thị Hộp Mừng Cưới
                    </label>
                </div>
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-plus-circle"></i> Thêm Khách Mời
                </button>
                <div class="success-message" id="successMessage"></div>
            </form>

            <!-- Guest List -->
            <div class="guest-list">
                <h3><i class="fas fa-list-ul"></i> Danh Sách Khách Mời</h3>
                <div id="guestListContainer">
                    <!-- Guest items will be dynamically added here -->
                </div>
            </div>

            <!-- Logout Button -->
            <button id="logoutBtn" class="btn btn-secondary">
                <i class="fas fa-sign-out-alt"></i> Đăng xuất
            </button>
        </div>
    </div>
</div>

<!-- QR Code Modal -->
<div id="qrModal" class="qr-modal">
    <div class="qr-modal-content">
        <span class="close-qr-modal">&times;</span>

        <div class="qr-decoration-top">❀</div>

        <h3 class="qr-title">Mời Đám Cưới</h3>
        <p id="qrGuestName" class="qr-guest-name"></p>

        <div class="qr-wrapper">
            <div id="qrcodeDisplay"></div>
            <!-- Center Logo Overlay -->
            <div class="qr-center-logo">
                <i class="fas fa-heart"></i>
            </div>
        </div>

        <p class="qr-footer">Quét mã để xem thiệp mời</p>
        <div class="qr-decoration-bottom">❀</div>
    </div>
</div>