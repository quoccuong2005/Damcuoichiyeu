<div class="wedding-container">
    <!-- Background decoration -->
    <div class="bg-decoration">
        <div class="floating-hearts">
            <i class="fas fa-heart"></i>
            <i class="fas fa-heart"></i>
            <i class="fas fa-heart"></i>
            <i class="fas fa-heart"></i>
        </div>
    </div>

    <!-- Hero Section -->
    <section class="hero-section">
        <!-- Flower Decorations -->
        <div class="petal"></div>
        <div class="petal"></div>
        <div class="petal"></div>
        <div class="petal"></div>
        <div class="petal">♥</div>
        <div class="petal">♥</div>
        <div class="petal">♥</div>
        <div class="petal">♥</div>

        <div class="hero-content">
            <p class="save-the-date">Save The Date</p>
            <h1 class="couple-names-hero">
                <%= theme.groom %><span class="ampersand">&</span>
                    <%= theme.bride %>
            </h1>
            <p class="wedding-date-hero">
                <%= theme.wedding_date %>
            </p>

            <!-- Countdown Timer -->
            <div class="countdown-timer" id="countdown" data-wedding-date="<%= theme.wedding_date %>"
                data-wedding-time="<%= theme.groom_time || '00:00' %>">
                <div class="countdown-item">
                    <span class="countdown-number" id="days">00</span>
                    <span class="countdown-label">Ngày</span>
                </div>
                <div class="countdown-item">
                    <span class="countdown-number" id="hours">00</span>
                    <span class="countdown-label">Giờ</span>
                </div>
                <div class="countdown-item">
                    <span class="countdown-number" id="minutes">00</span>
                    <span class="countdown-label">Phút</span>
                </div>
                <div class="countdown-item">
                    <span class="countdown-number" id="seconds">00</span>
                    <span class="countdown-label">Giây</span>
                </div>
            </div>
        </div>

        <div class="scroll-down">
            <i class="fas fa-chevron-down"></i>
        </div>
    </section>

    <!-- Guest Greeting Section (shown only if query param exists) -->
    <section class="guest-greeting-section" id="guestGreetingSection" style="display: none;">
        <p class="greeting-text">Kính mời</p>
        <h2 class="guest-name" id="guestName"></h2>
        <p>đến dự tiệc cưới của chúng tôi</p>
    </section>

    <!-- Divider -->
    <div class="divider">
        <span class="ornament">❀</span>
        <i class="fas fa-heart divider-icon"></i>
        <span class="ornament">❀</span>
    </div>

    <!-- Invitation Section -->
    <section class="invitation-section">
        <div class="section-container">
            <h2 class="section-title">Thiệp Mời Đám Cưới</h2>
            <p class="section-subtitle">Trân trọng kính mời quý khách đến dự lễ cưới của chúng tôi</p>

            <!-- Tab Navigation -->
            <div class="invitation-tabs">
                <button class="tab-btn active" data-tab="nha-trai">
                    <i class="fas fa-rings-wedding"></i> Nhà Trai
                </button>
                <button class="tab-btn" data-tab="nha-gai">
                    <i class="fas fa-heart"></i> Nhà Gái
                </button>
            </div>

            <!-- Nhà Trai Card -->
            <div class="invitation-card tab-content active" id="nha-trai">
                <div class="invitation-header">
                    <p class="invitation-intro">Trân Trọng Kính Mời</p>
                    <p class="invitation-desc">Tới dự bữa cơm thân mật chung vui cùng gia đình chúng tôi</p>
                </div>

                <div class="couple-names">
                    <span class="groom-name">
                        <%= theme.groom_full || theme.groom %>
                    </span>
                    <i class="fas fa-heart heart-icon"></i>
                    <span class="bride-name">
                        <%= theme.bride_full || theme.bride %>
                    </span>
                </div>

                <!-- Tiệc Cưới Section (25/01) -->
                <div class="ceremony-info reception-info">
                    <p class="ceremony-type reception-type">
                        Tiệc Cưới
                    </p>
                    <div class="ceremony-datetime">
                        <p class="time-line">Vào lúc <strong>
                                <%= theme.groom_reception_time %>
                            </strong> giờ, <strong>
                                <%= theme.groom_reception_day %>
                            </strong></p>
                        <p class="date-main">
                            <%= theme.groom_reception_date %>
                        </p>
                        <p class="date-lunar">(<%= theme.groom_reception_date_lunar %>)</p>
                    </div>
                    <div class="ceremony-location">
                        <p class="venue-label">Tại:</p>
                        <p class="venue-name">
                            <%= theme.groom_reception_venue %>
                        </p>
                        <p class="venue-address">
                            <%= theme.groom_reception_address %>
                        </p>
                    </div>
                </div>

                <!-- Lễ Thành Hôn Section (26/01) -->
                <div class="ceremony-info">
                    <p class="ceremony-type">
                        <%= theme.groom_ceremony || 'Lễ Thành Hôn' %>
                    </p>
                    <div class="ceremony-datetime">
                        <p class="time-line">Vào lúc <strong>
                                <%= theme.groom_time %>
                            </strong> giờ, <strong>
                                <%= theme.groom_day %>
                            </strong></p>
                        <p class="date-main">
                            <%= theme.groom_date %>
                        </p>
                        <p class="date-lunar">(<%= theme.groom_date_lunar %>)</p>
                    </div>
                    <div class="ceremony-location">
                        <p class="venue-label">Tại:</p>
                        <p class="venue-name">
                            <%= theme.groom_venue %>
                        </p>
                        <p class="venue-address">
                            <%= theme.groom_address %>
                        </p>
                    </div>
                </div>

                <p class="invitation-closing">Rất hân hạnh được đón tiếp!</p>

                <div class="parents-section">
                    <div class="parent-col">
                        <p class="parent-label">Nhà Trai</p>
                        <p class="parent-name">Bố: <%= theme.groom_father %>
                        </p>
                        <p class="parent-name">Mẹ: <%= theme.groom_mother %>
                        </p>
                    </div>
                    <div class="parent-col">
                        <p class="parent-label">Nhà Gái</p>
                        <p class="parent-name">Bố: <%= theme.bride_father %>
                        </p>
                        <p class="parent-name">Mẹ: <%= theme.bride_mother %>
                        </p>
                    </div>
                </div>

                <div class="invitation-footer">
                    <p>Sự hiện diện của Quý khách là niềm vinh hạnh cho gia đình chúng tôi!</p>
                </div>
            </div>

            <!-- Nhà Gái Card -->
            <div class="invitation-card tab-content" id="nha-gai">
                <div class="invitation-header">
                    <p class="invitation-intro">Trân Trọng Kính Mời</p>
                    <p class="invitation-desc">Tới dự bữa cơm thân mật chung vui cùng gia đình chúng tôi</p>
                </div>

                <!--  -->
                <div class="couple-names">
                    <span class="bride-name">
                        <%= theme.bride_full || theme.bride %>
                    </span>
                    <i class="fas fa-heart heart-icon"></i>
                    <span class="groom-name">
                        <%= theme.groom_full || theme.groom %>
                    </span>
                </div>

                <!-- Tiệc Cưới Section (25/01) -->
                <div class="ceremony-info reception-info">
                    <p class="ceremony-type reception-type">
                        Tiệc Cưới
                    </p>
                    <div class="ceremony-datetime">
                        <p class="time-line">Vào lúc <strong>
                                <%= theme.bride_reception_time %>
                            </strong> giờ, <strong>
                                <%= theme.bride_reception_day %>
                            </strong></p>
                        <p class="date-main">
                            <%= theme.bride_reception_date %>
                        </p>
                        <p class="date-lunar">(<%= theme.bride_reception_date_lunar %>)</p>
                    </div>
                    <div class="ceremony-location">
                        <p class="venue-label">Tại:</p>
                        <p class="venue-name">
                            <%= theme.bride_reception_venue %>
                        </p>
                        <p class="venue-address">
                            <%= theme.bride_reception_address %>
                        </p>
                    </div>
                </div>

                <!-- Lễ Vu Quy Section (26/01) -->
                <div class="ceremony-info">
                    <p class="ceremony-type">
                        <%= theme.bride_ceremony || 'Lễ Vu Quy' %>
                    </p>
                    <div class="ceremony-datetime">
                        <p class="time-line">Vào lúc <strong>
                                <%= theme.bride_time %>
                            </strong> giờ, <strong>
                                <%= theme.bride_day %>
                            </strong></p>
                        <p class="date-main">
                            <%= theme.bride_date %>
                        </p>
                        <p class="date-lunar">(<%= theme.bride_date_lunar %>)</p>
                    </div>
                    <div class="ceremony-location">
                        <p class="venue-label">Tại:</p>
                        <p class="venue-name">
                            <%= theme.bride_venue %>
                        </p>
                        <p class="venue-address">
                            <%= theme.bride_address %>
                        </p>
                    </div>
                </div>

                <p class="invitation-closing">Rất hân hạnh được đón tiếp!</p>

                <div class="parents-section">
                    <div class="parent-col">
                        <p class="parent-label">Nhà Gái</p>
                        <p class="parent-name">Bố: <%= theme.bride_father %>
                        </p>
                        <p class="parent-name">Mẹ: <%= theme.bride_mother %>
                        </p>
                    </div>
                    <div class="parent-col">
                        <p class="parent-label">Nhà Trai</p>
                        <p class="parent-name">Bố: <%= theme.groom_father %>
                        </p>
                        <p class="parent-name">Mẹ: <%= theme.groom_mother %>
                        </p>
                    </div>
                </div>

                <div class="invitation-footer">
                    <p>Sự hiện diện của Quý khách là niềm vinh hạnh cho gia đình chúng tôi!</p>
                </div>
            </div>

        </div>
    </section>

    <!-- =============================================
         FLIP BOOK SECTION (Desktop Only)
         ============================================= -->
    <section class="flip-book-section desktop-only">
        <div class="section-container">
            <h2 class="section-title">Album & Câu Chuyện Của Chúng Tôi</h2>
            <p class="section-subtitle">Lật từng trang để khám phá hành trình tình yêu</p>

            <div class="flip-book-wrapper">
                <div class="flip-book" id="flipBook">
                    <!-- Cover Page -->
                    <div class="page cover-page" data-page="0">
                        <div class="page-front">
                            <div class="cover-content">
                                <div class="cover-ornament">❀</div>
                                <h2 class="cover-title">Album Ảnh Cưới</h2>
                                <p class="cover-subtitle">
                                    <%= theme.groom %> & <%= theme.bride %>
                                </p>
                                <div class="cover-date">
                                    <%= theme.wedding_date %>
                                </div>
                                <div class="cover-ornament">❀</div>
                            </div>
                        </div>
                        <div class="page-back">
                            <div class="page-content photo-page with-story">
                                <img src="/images/photo1.jpg" alt="Wedding Photo 1">
                                <div class="story-bubble">
                                    <div class="bubble-content">
                                        <span class="bubble-date">Tháng 3, 2021</span>
                                        <span class="bubble-title">Lần Đầu Quen Nhau</span>
                                        <span class="bubble-text">Chúng tôi gặp nhau lần đầu tiên. Đó là khởi đầu
                                            của một câu chuyện tình yêu đẹp!</span>
                                    </div>
                                    <div class="bubble-arrow"></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Photo Page 1 -->
                    <div class="page" data-page="1">
                        <div class="page-front">
                            <div class="page-content photo-page with-story">
                                <img src="/images/photo2.jpg" alt="Wedding Photo 2">
                                <div class="story-bubble">
                                    <div class="bubble-content">
                                        <span class="bubble-date">20/04/2022</span>
                                        <span class="bubble-title">Lời Tỏ Tình</span>
                                        <span class="bubble-text">Một ngày đặc biệt khi chúng tôi chính thức bắt đầu
                                            hành trình yêu thương bên nhau.</span>
                                    </div>
                                    <div class="bubble-arrow"></div>
                                </div>
                            </div>
                        </div>
                        <div class="page-back">
                            <div class="page-content photo-page with-story">
                                <img src="/images/photo3.jpg" alt="Wedding Photo 3">
                                <div class="story-bubble">
                                    <div class="bubble-content">
                                        <span class="bubble-date">06/09/2025</span>
                                        <span class="bubble-title">Lời Cầu Hôn</span>
                                        <span class="bubble-text">Một lời cầu hôn lãng mạn. "Em đồng ý!" Đó là
                                            khoảnh khắc hạnh phúc nhất!</span>
                                    </div>
                                    <div class="bubble-arrow"></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Photo Page 2 -->
                    <div class="page" data-page="2">
                        <div class="page-front">
                            <div class="page-content photo-page with-story">
                                <img src="/images/photo4.jpg" alt="Wedding Photo 4">
                                <div class="story-bubble">
                                    <div class="bubble-content">
                                        <span class="bubble-date">30/09/2025</span>
                                        <span class="bubble-title">Lễ Dặm Ngõ</span>
                                        <span class="bubble-text">Hai gia đình gặp mặt, chính thức khởi đầu cho
                                            hành trình tiến tới hôn nhân.</span>
                                    </div>
                                    <div class="bubble-arrow"></div>
                                </div>
                            </div>
                        </div>
                        <div class="page-back">
                            <div class="page-content photo-page with-story">
                                <img src="/images/photo5.jpg" alt="Wedding Photo 5">
                                <div class="story-bubble">
                                    <div class="bubble-content">
                                        <span class="bubble-date">30/10/2025</span>
                                        <span class="bubble-title">Lễ Ăn Hỏi</span>
                                        <span class="bubble-text">Ngày trọng đại đánh dấu sự gắn kết chính thức
                                            giữa hai gia đình.</span>
                                    </div>
                                    <div class="bubble-arrow"></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Photo Page 3 -->
                    <div class="page" data-page="3">
                        <div class="page-front">
                            <div class="page-content photo-page with-story">
                                <img src="/images/photo6.jpg" alt="Wedding Photo 6">
                                <div class="story-bubble">
                                    <div class="bubble-content">
                                        <span class="bubble-date">26/01/2026</span>
                                        <span class="bubble-title">Đám Cưới</span>
                                        <span class="bubble-text">Chúng tôi chính thức nên duyên vợ chồng, bắt đầu
                                            chương mới hạnh phúc bên nhau!</span>
                                    </div>
                                    <div class="bubble-arrow"></div>
                                </div>
                            </div>
                        </div>
                        <div class="page-back">
                            <div class="page-content photo-page with-story">
                                <img src="/images/photo9.jpg" alt="Wedding Photo 9">
                                <div class="story-bubble">
                                    <div class="bubble-content">
                                        <span class="bubble-date">2025</span>
                                        <span class="bubble-title">Khoảnh Khắc Đẹp</span>
                                        <span class="bubble-text">Những khoảnh khắc hạnh phúc bên nhau,
                                            lưu giữ mãi trong tim.</span>
                                    </div>
                                    <div class="bubble-arrow"></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Photo Page 4 + Back Cover -->
                    <div class="page back-cover-page" data-page="4">
                        <div class="page-front">
                            <div class="page-content photo-page with-story">
                                <img src="/images/photo10.jpg" alt="Wedding Photo 10">
                                <div class="story-bubble">
                                    <div class="bubble-content">
                                        <span class="bubble-date">Mãi Mãi</span>
                                        <span class="bubble-title">Yêu Thương</span>
                                        <span class="bubble-text">Tình yêu của chúng tôi sẽ mãi vững bền
                                            theo năm tháng.</span>
                                    </div>
                                    <div class="bubble-arrow"></div>
                                </div>
                            </div>
                        </div>
                        <div class="page-back">
                            <div class="page-content back-cover">
                                <div class="back-cover-content">
                                    <i class="fas fa-heart"></i>
                                    <h3>Cảm ơn bạn đã xem</h3>
                                    <p>Hẹn gặp bạn trong ngày cưới!</p>
                                    <p class="couple-sign">
                                        <%= theme.groom %> & <%= theme.bride %>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Navigation Buttons -->
                <button class="flip-nav flip-prev" id="flipPrev" disabled>
                    <i class="fas fa-chevron-left"></i>
                </button>
                <button class="flip-nav flip-next" id="flipNext">
                    <i class="fas fa-chevron-right"></i>
                </button>

                <!-- Page Indicator -->
                <div class="page-indicator">
                    <span id="currentPage">1</span> / <span id="totalPages">4</span>
                </div>
            </div>
        </div>
    </section>


    <!-- =============================================
         MOBILE ONLY: Photo Gallery Section
         ============================================= -->
    <div class="divider mobile-only">
        <span class="ornament">❀</span>
        <i class="fas fa-rings-wedding divider-icon"></i>
        <span class="ornament">❀</span>
    </div>

    <section class="gallery-section">
        <div class="section-container">
            <h2 class="section-title">Album Ảnh Cưới</h2>
            <p class="section-subtitle">57 khoảnh khắc trong album của chúng tôi</p>

            <!-- Carousel Container -->
            <div class="photo-carousel" id="photoCarousel">
                <div class="carousel-track" id="carouselTrack">
                    <% for (let index = 1; index <= 57; index += 1) { %>
                        <div class="carousel-slide">
                            <img src="/images/photo<%= index %>.jpg" alt="Ảnh cưới <%= index %>"
                                loading="<%= index === 1 ? 'eager' : 'lazy' %>" decoding="async">
                        </div>
                    <% } %>
                </div>

                <!-- Navigation Arrows -->
                <button class="carousel-btn carousel-prev" id="carouselPrev">
                    <i class="fas fa-chevron-left"></i>
                </button>
                <button class="carousel-btn carousel-next" id="carouselNext">
                    <i class="fas fa-chevron-right"></i>
                </button>

                <!-- Indicator Dots (Hidden, replaced by thumbnails) -->
                <div class="carousel-dots" id="carouselDots" style="display: none;"></div>
            </div>

            <!-- Carousel Thumbnails -->
            <div class="carousel-thumbnails" id="carouselThumbnails">
                <% for (let index = 1; index <= 57; index += 1) { %>
                    <div class="thumb-item<%= index === 1 ? ' active' : '' %>" data-index="<%= index - 1 %>">
                        <img src="/images/photo<%= index %>.jpg" alt="Ảnh thu nhỏ <%= index %>" loading="lazy"
                            decoding="async">
                    </div>
                <% } %>
            </div>
        </div>
    </section>

    <!-- MOBILE ONLY: Divider -->
    <div class="divider mobile-only">
        <span class="ornament">❀</span>
        <i class="fas fa-heart divider-icon"></i>
        <span class="ornament">❀</span>
    </div>

    <!-- MOBILE ONLY: Love Story Timeline Section -->
